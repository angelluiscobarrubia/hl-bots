# ===== Database =====
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepass
POSTGRES_DB=bot_platform
DATABASE_URL=postgresql+asyncpg://admin:securepass@localhost:5432/bot_platform

# ===== Cache / Paper broker =====
REDIS_URL=redis://localhost:6379/0

# ===== Encryption (Fernet, 32 url-safe base64 bytes) =====
# Genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=__GENERA_UNA_KEY_CON: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"__

# ===== JWT / Auth =====
JWT_SECRET=__CAMBIA_ESTE_SECRETO_EN_PRODUCCION__
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ===== Hyperliquid =====
HYPERLIQUID_MAINNET_URL=https://api.hyperliquid.xyz
HYPERLIQUID_TESTNET_URL=https://api.hyperliquid-testnet.xyz

# ===== Notificaciones =====
TELEGRAM_BOT_TOKEN=__OPCIONAL__
TELEGRAM_DEFAULT_CHAT_ID=__OPCIONAL__

# ===== App =====
APP_ENV=development
LOG_LEVEL=INFO
